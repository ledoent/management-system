<odoo noupdate="1">
    <record id="system_isms_demo" model="mgmtsystem.system">
        <field name="name">Information Security (ISO 27001 demo)</field>
        <field name="company_id" eval="False" />
    </record>

    <!-- Access-control family → ENFORCED: each maps to the Management System
         privilege, so the documented control points at real Odoo access. -->
    <record id="control_a_5_15" model="mgmtsystem.security.control">
        <field name="name">Access control</field>
        <field name="iso27001_ref">A.5.15</field>
        <field name="iso27001_theme">organizational</field>
        <field
            name="privilege_ids"
            eval="[Command.set([ref('mgmtsystem.res_groups_privilege_management_system')])]"
        />
        <field name="system_id" ref="system_isms_demo" />
        <field
            name="description"
        >Rules to control physical and logical access to information, established and implemented based on business and information security requirements.</field>
    </record>

    <record id="control_a_5_18" model="mgmtsystem.security.control">
        <field name="name">Access rights</field>
        <field name="iso27001_ref">A.5.18</field>
        <field name="iso27001_theme">organizational</field>
        <field
            name="privilege_ids"
            eval="[Command.set([ref('mgmtsystem.res_groups_privilege_management_system')])]"
        />
        <field name="system_id" ref="system_isms_demo" />
        <field
            name="description"
        >Access rights to information provisioned, reviewed, modified and removed in accordance with the access control policy.</field>
    </record>

    <record id="control_a_8_2" model="mgmtsystem.security.control">
        <field name="name">Privileged access rights</field>
        <field name="iso27001_ref">A.8.2</field>
        <field name="iso27001_theme">technological</field>
        <field
            name="privilege_ids"
            eval="[Command.set([ref('mgmtsystem.res_groups_privilege_management_system')])]"
        />
        <field name="system_id" ref="system_isms_demo" />
        <field
            name="description"
        >Allocation and use of privileged access rights restricted and managed.</field>
    </record>

    <record id="control_a_8_3" model="mgmtsystem.security.control">
        <field name="name">Information access restriction</field>
        <field name="iso27001_ref">A.8.3</field>
        <field name="iso27001_theme">technological</field>
        <field
            name="privilege_ids"
            eval="[Command.set([ref('mgmtsystem.res_groups_privilege_management_system')])]"
        />
        <field name="system_id" ref="system_isms_demo" />
        <field
            name="description"
        >Access to information and other associated assets restricted in accordance with the access control policy.</field>
    </record>

    <!-- Governance family → DOCUMENTED only: no Odoo privilege enforces a
         written policy, so these stay 'documented'. Shows the contrast. -->
    <record id="control_a_5_1" model="mgmtsystem.security.control">
        <field name="name">Policies for information security</field>
        <field name="iso27001_ref">A.5.1</field>
        <field name="iso27001_theme">organizational</field>
        <field name="system_id" ref="system_isms_demo" />
        <field
            name="description"
        >Information security policy and topic-specific policies defined, approved, published and acknowledged.</field>
    </record>

    <record id="control_a_6_3" model="mgmtsystem.security.control">
        <field
            name="name"
        >Information security awareness, education and training</field>
        <field name="iso27001_ref">A.6.3</field>
        <field name="iso27001_theme">people</field>
        <field name="system_id" ref="system_isms_demo" />
        <field
            name="description"
        >Personnel receive appropriate awareness, education and training and regular updates of policies relevant to their role.</field>
    </record>
</odoo>
